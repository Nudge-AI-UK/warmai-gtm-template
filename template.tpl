___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Warm AI - Website Visitor Identification
//
// Loads the per-domain Warm AI tracker:
//
//   https://cdn.menoinfra.com/p/<tracking id>.js
//
// That file is assembled per customer at the edge, and the edge is where
// company-level tracking, the Snitcher Radar bootstrap and the RB2B
// person-level pixel are attached. Injecting the URL is therefore all this
// template has to do, and a GTM install gets exactly what a direct <head>
// install gets, now and after any future change to what the tracker carries.
//
// This replaces the v1 template, which posted a hand-rolled event payload to
// a bespoke endpoint. That endpoint no longer exists, and the parallel
// pipeline behind it was the reason GTM installs silently diverged from
// direct installs. Nothing is hand-rolled here any more.
//
// Consent is handled by the tracker itself: it detects Cookiebot, OneTrust,
// Transcend, CookieYes, Klaro and GTM consent mode, and gates person-level
// identification on consent for EU, EEA and UK visitors. Do not add a
// consent check here as well; you would double-gate it.

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');

const trackingId = data.trackingId;

if (!trackingId) {
  data.gtmOnFailure();
  return;
}

const host = data.scriptHost || 'cdn.menoinfra.com';
const url = 'https://' + host + '/p/' + encodeUriComponent(trackingId) + '.js';

// The URL doubles as the cache token, so a tag firing on several triggers
// loads the tracker once per page rather than once per fire.
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, url);


